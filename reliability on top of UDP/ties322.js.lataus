var currentId = 'id1';

function unhide(divID) {
	var item = document.getElementById(divID);
	if (item) {
		item.className=(item.className=='hidden')?'unhidden':'hidden';
	}
}
function showVideo(videoid,id) {
	currentId = id;
	document.getElementById(videoid).src=associativeArray[id];
	var item = document.getElementById('www' + videoid);
	if (item.className=='hidden') {
		unhide('www' + videoid);
	}
}

function nextVideo(videoid) {
	var number = videoid.substring(videoid.length-1, videoid.length);
	var tempInt = parseInt(currentId.substring(2, currentId.length));
/*	if (tempInt >= associativeArray.length) { 
		alert('Se oli viimeinen video. Lisää videoita tulee myöhemmin...');
	}*/
	if (number == 1 && tempInt < 8) {
		tempInt += 1;
		currentId = 'id' + tempInt.toString();
		showVideo(videoid, currentId);
	}
	/*else if (number == 2 && tempInt < 13) {
		tempInt += 1;
		currentId = 'id' + tempInt.toString();
		showVideo(videoid, currentId);
	}
	else if (number == 3 && tempInt < 19) {
		tempInt += 1;
		currentId = 'id' + tempInt.toString();
		showVideo(videoid, currentId);
	}
	else if (number == 4 && tempInt < 24) {
		tempInt += 1;
		currentId = 'id' + tempInt.toString();
		showVideo(videoid, currentId);
	}
	else if (number == 5 && tempInt < 27) {
		tempInt += 1;
		currentId = 'id' + tempInt.toString();
		showVideo(videoid, currentId);
	}*/
}

function prevVideo(videoid) {
	var number = videoid.substring(videoid.length-1, videoid.length);
	var tempInt = parseInt(currentId.substring(2, currentId.length));
	/*if (tempInt < 1) { 
		alert('Se oli osion ' + number + ' ensimmäinen video.  Lisää videoita tulee myöhemmin...');
	}*/
	if (number == 1 && tempInt > 1) {
		tempInt -= 1;
		currentId = 'id' + tempInt.toString();
		showVideo(videoid, currentId);
	}
	/*else if (number == 2 && tempInt > 9) {
		tempInt -= 1;
		currentId = 'id' + tempInt.toString();
		showVideo(videoid, currentId);
	}
	else if (number == 3 && tempInt > 14) {
