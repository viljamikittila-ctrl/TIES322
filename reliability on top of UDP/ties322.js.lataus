var associativeArray = {};
associativeArray['id1'] = 'https://m3.jyu.fi/jyumv/embed?uid=6f4fec0cb740454882fe91e32782667e';
associativeArray['id2'] = 'https://m3.jyu.fi/jyumv/embed?uid=6dd63de77a4a42d29104dc34446fb9bf';
