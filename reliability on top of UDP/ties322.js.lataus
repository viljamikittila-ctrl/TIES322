	}
	else if (number == 4 && tempInt > 20) {
		tempInt -= 1;
		currentId = 'id' + tempInt.toString();
		showVideo(videoid, currentId);
	}
	else if (number == 5 && tempInt > 25) {
		tempInt -= 1;
		currentId = 'id' + tempInt.toString();
		showVideo(videoid, currentId);
	}*/
}

function changeSize(id) {
	var number = id.substring(id.length-1, id.length);
	var newwidth = 640;
	var newheight = 400;
	if (document.getElementById(id).value == "s300"){
		newwidth = 300;
		newheight = 200;
	}
	else if (document.getElementById(id).value == "s640"){
		newwidth = 640;
		newheight = 400;
	}
	else if (document.getElementById(id).value == "s800"){
		newwidth = 800;
		newheight = 500;
	}
	else if (document.getElementById(id).value == "s960"){
		newwidth = 960;
		newheight = 600;
	}
	else if (document.getElementById(id).value == "s1024"){
		newwidth = 1024;
		newheight = 650;
	}
	else if (document.getElementById(id).value == "s1280"){
		newwidth = 1280;
		newheight = 800;
	}
	else if (document.getElementById(id).value == "s1680"){
		newwidth = 1680;
		newheight = 1050;
	}
	document.getElementById('Video' + number).width= (newwidth) + "px";
	document.getElementById('Video' + number).height= (newheight) + "px";
}
